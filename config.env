# ─── cluster nodes ────────────────────────────────────────────────────────────
SERVER_IP=192.168.0.28
SERVER_SSH_USER=ubuntu

# GPU agent name as it will appear in kubectl get nodes
GPU_NODE_NAME=gpu-node

# ─── k3s ──────────────────────────────────────────────────────────────────────
# stable | latest | v1.X.Y+k3s1
K3S_CHANNEL=stable

# ─── workloads ────────────────────────────────────────────────────────────────
NAMESPACE=clusty
